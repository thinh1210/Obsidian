#!/bin/sh
### BEGIN INIT INFO
# Provides:          sensor-telemetry
# Required-Start:    $local_fs $network
# Required-Stop:     $local_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: IoT Sensor Telemetry Daemon
### END INIT INFO

DAEMON=/usr/bin/sensor-telemetry
PIDFILE=/var/run/sensor-telemetry.pid

case "$1" in
  start)
    echo "Starting sensor-telemetry daemon..."
    start-stop-daemon --start --background --make-pidfile --pidfile $PIDFILE --exec $DAEMON
    ;;
  stop)
    echo "Stopping sensor-telemetry daemon..."
    start-stop-daemon --stop --pidfile $PIDFILE
    rm -f $PIDFILE
    ;;
  restart)
    $0 stop
    sleep 1
    $0 start
    ;;
  status)
    start-stop-daemon --status --pidfile $PIDFILE
    ;;
  *)
    echo "Usage: $0 {start|stop|restart|status}"
    exit 1
    ;;
esac
exit 0
