From 1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b Mon Sep 17 00:00:00 2001
From: Thinh Embedded Developer <thinh@embedded.local>
Date: Fri, 23 Oct 2026 21:00:00 +0700
Subject: [PATCH] board: ti: am335x: Bypass I2C EEPROM check & enable SPL USR0 LED

MỤC ĐÍCH BẢN VÁ (Theo tài liệu TI Processor SDK Linux U-Boot Board Porting Guide):
1. Trong thực tế khi thiết kế bo mạch Custom dựa trên BeagleBone Black (AM335x),
   chip EEPROM I2C0 (địa chỉ 0x50) thường bị loại bỏ để giảm giá thành BOM, hoặc
   khi mới hàn mạch xong EEPROM hoàn toàn trắng (chứa toàn 0xFF).
2. Bản vá này sửa hàm read_eeprom() trong board/ti/am335x/board.c để tự động
   gán cứng định danh "A335BNLT" (BeagleBone Black Rev C), giúp SPL khởi tạo
   đúng xung nhịp DDR3 400MHz và điện áp PMIC TPS65217C 1.325V mà không bị treo.
3. Bật sáng ngay đèn LED USR0 (GPIO1_21) trong giai đoạn SPL để báo hiệu phần cứng
   đã vượt qua bước khởi tạo RAM thành công.
---
 board/ti/am335x/board.c | 29 +++++++++++++++++++++++++++--
 1 file changed, 27 insertions(+), 2 deletions(-)

diff --git a/board/ti/am335x/board.c b/board/ti/am335x/board.c
index 4a8d7e1..9c3f5b2 100644
--- a/board/ti/am335x/board.c
+++ b/board/ti/am335x/board.c
@@ -72,8 +72,26 @@
 static int read_eeprom(void)
 {
-	return ti_i2c_eeprom_am_get(CONFIG_EEPROM_BUS_ADDRESS,
-			CONFIG_EEPROM_CHIP_ADDRESS);
+	int rc;
+	struct ti_am_eeprom *ep = TI_AM_EEPROM_DATA;
+
+	/* Thử đọc EEPROM I2C0 thực tế trước */
+	rc = ti_i2c_eeprom_am_get(CONFIG_EEPROM_BUS_ADDRESS,
+				  CONFIG_EEPROM_CHIP_ADDRESS);
+	if (rc == 0)
+		return 0;
+
+	/*
+	 * FALLBACK CHO BO MẠCH CUSTOM (KHÔNG CÓ EEPROM HOẶC EEPROM TRẮNG):
+	 * Tự động giả lập dữ liệu định danh của BeagleBone Black Rev C (A335BNLT)
+	 */
+	puts("SPL/U-Boot: EEPROM not found or blank! Using hardcoded A335BNLT profile.\n");
+	ep->header = 0xEE3355AA;
+	strlcpy(ep->name, "A335BNLT", sizeof(ep->name));
+	strlcpy(ep->version, "00C0", sizeof(ep->version));
+	strlcpy(ep->serial, "2026CUSTOM01", sizeof(ep->serial));
+	strlcpy(ep->config, "SKU#00", sizeof(ep->config));
+
+	return 0;
 }
 
 #ifndef CONFIG_DM_SERIAL
@@ -495,6 +513,13 @@ void sdram_init(void)
 		config_ddr(400, &ioregs_bonelt,
 			   &ddr3_beagleblack_data,
 			   &ddr3_beagleblack_cmd_ctrl_data,
 			   &ddr3_beagleblack_emif_reg_data, 0);
+
+	/*
+	 * Bật đèn LED USR0 (GPIO1_21) ngay sau khi DDR3 RAM khởi tạo xong
+	 * Báo hiệu cho kỹ sư biết giai đoạn SPL đã thành công tốt đẹp!
+	 */
+	gpio_request(53, "spl_usr0_led"); /* 32*1 + 21 = GPIO 53 */
+	gpio_direction_output(53, 1);
 }
 #endif
